{
  "manifest_version": 3,
  "name": "You Resume",
  "version": "1.1.0",
  "description": "Locally saves and restores YouTube video playback positions.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://www.youtube.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "You Resume",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "you-resume-local@example.com",
      "strict_min_version": "128.0"
    }
  }
}
